# --- Public (safe in client bundles) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# SUPABASE FUNCTION SECRETS (set with `supabase secrets set ...`)
# Server-only — NEVER prefix with NEXT_PUBLIC_. Mark each as "Sensitive" if
# you must mirror any of these on Vercel.
# ============================================================================

# Supabase service-role key for edge functions
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Local LLM stack (default path) ---
# Ollama (dev) or vLLM (prod) HTTPS endpoint reachable from Supabase Edge Functions.
# Never expose this to the public internet — keep it private-network or behind a
# Cloudflare Tunnel and authenticate with the bearer token below.
LLM_BASE_URL=http://your-gpu-host:11434
LLM_BEARER_TOKEN=

# Pinned default models (see PROMPT_DESIGN.md → Hard Caps).
LLM_SYNTHESIS_MODEL=deepseek-r1-distill-qwen-32b
LLM_ANALYSIS_MODEL=gemma3:4b
LLM_EMBEDDING_MODEL=nomic-embed-text

# ============================================================================
# OPTIONAL FALLBACKS
# Vendor LLM keys are ONLY loaded when LLM_FALLBACK_ENABLED=true. Default is
# false — the local stack above is the only path the code takes. Treat these
# as the break-glass option for when the GPU host is down.
# ============================================================================
LLM_FALLBACK_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
